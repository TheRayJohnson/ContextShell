<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<!-- Windows 11 dark palette. Accent is a lighter brand blue with dark text for contrast. -->
	<SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202020" />
	<SolidColorBrush x:Key="SurfaceBrush" Color="#0DFFFFFF" />
	<SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#19000000" />
	<SolidColorBrush x:Key="FooterBrush" Color="#4D1C1C1C" />
	<SolidColorBrush x:Key="DividerBrush" Color="#15FFFFFF" />

	<SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
	<SolidColorBrush x:Key="TextSecondaryBrush" Color="#C5FFFFFF" />
	<SolidColorBrush x:Key="TextTertiaryBrush" Color="#87FFFFFF" />

	<SolidColorBrush x:Key="AccentBrush" Color="#5CB8FF" />
	<SolidColorBrush x:Key="AccentHoverBrush" Color="#72C3FF" />
	<SolidColorBrush x:Key="AccentPressedBrush" Color="#4AA4EB" />
	<SolidColorBrush x:Key="AccentDisabledBrush" Color="#28FFFFFF" />
	<SolidColorBrush x:Key="AccentTextBrush" Color="#000000" />
	<SolidColorBrush x:Key="AccentForegroundBrush" Color="#7CC8FF" />
	<SolidColorBrush x:Key="AccentSubtleBrush" Color="#265CB8FF" />

	<SolidColorBrush x:Key="ControlBrush" Color="#0FFFFFFF" />
	<SolidColorBrush x:Key="ControlHoverBrush" Color="#15FFFFFF" />
	<SolidColorBrush x:Key="ControlPressedBrush" Color="#08FFFFFF" />
	<SolidColorBrush x:Key="ControlStrokeBrush" Color="#18FFFFFF" />
	<SolidColorBrush x:Key="ControlStrongStrokeBrush" Color="#8BFFFFFF" />
	<SolidColorBrush x:Key="SubtleHoverBrush" Color="#0FFFFFFF" />
	<SolidColorBrush x:Key="SubtlePressedBrush" Color="#0AFFFFFF" />

	<SolidColorBrush x:Key="InputBrush" Color="#0FFFFFFF" />
	<SolidColorBrush x:Key="InputFocusBrush" Color="#B31E1E1E" />
	<SolidColorBrush x:Key="InputUnderlineBrush" Color="#8BFFFFFF" />

	<SolidColorBrush x:Key="TrackBrush" Color="#28FFFFFF" />
	<SolidColorBrush x:Key="SuccessBrush" Color="#6CCB5F" />
	<SolidColorBrush x:Key="CautionBrush" Color="#FCE100" />
	<SolidColorBrush x:Key="CriticalBrush" Color="#FF99A4" />
	<SolidColorBrush x:Key="CriticalSubtleBrush" Color="#442726" />
	<SolidColorBrush x:Key="FocusBrush" Color="#FFFFFF" />
	<SolidColorBrush x:Key="OverlayBrush" Color="#80000000" />
	<SolidColorBrush x:Key="DialogBrush" Color="#2B2B2B" />
</ResourceDictionary>
