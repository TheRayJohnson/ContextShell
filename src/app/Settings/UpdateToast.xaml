<Window x:Class="ContextShell.Settings.UpdateToast"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ContextShell update" Width="400" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="Manual" Topmost="True" ShowActivated="False"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal"
        FontFamily="{StaticResource UIFont}" FontSize="14">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<Grid Margin="20,18,20,16">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto" />
				<ColumnDefinition Width="*" />
			</Grid.ColumnDefinitions>
			<Image Source="/Assets/logo.png" Width="40" Height="40" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality" />
			<StackPanel Grid.Column="1" Margin="14,0,0,0">
				<TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongText}" />
				<TextBlock x:Name="BodyText" Margin="0,4,0,0" Style="{StaticResource SecondaryText}" MaxHeight="80" TextTrimming="CharacterEllipsis" />
				<ProgressBar x:Name="Bar" Margin="0,10,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" />
				<TextBlock x:Name="ErrorText" Margin="0,6,0,0" Style="{StaticResource CaptionText}" Foreground="{DynamicResource CriticalBrush}" Visibility="Collapsed" />
			</StackPanel>
		</Grid>
		<Border Grid.Row="1" Background="{DynamicResource FooterBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
			<Grid Margin="20,12">
				<Button x:Name="SkipButton" Style="{StaticResource LinkButton}" Content="Skip this version" FontSize="12" VerticalAlignment="Center" Click="Skip_Click" />
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
					<Button x:Name="LaterButton" Content="Later" Click="Later_Click" />
					<Button x:Name="UpdateButton" Margin="8,0,0,0" Style="{StaticResource AccentButton}" Content="Update now" Click="Update_Click" />
				</StackPanel>
			</Grid>
		</Border>
	</Grid>
</Window>
