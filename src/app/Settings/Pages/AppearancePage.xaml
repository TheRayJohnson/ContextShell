<UserControl x:Class="ContextShell.Settings.Pages.AppearancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<StackPanel Margin="36,28,36,36">
			<TextBlock Style="{StaticResource TitleText}" Text="Appearance" />
			<TextBlock Margin="0,6,0,0" Style="{StaticResource SecondaryText}"
			           Text="Pick how your right-click menu looks. Themes marked Light &amp; dark follow the Windows app mode." />

			<Grid Margin="0,24,0,10">
				<TextBlock Style="{StaticResource BodyStrongText}" Text="Themes" VerticalAlignment="Center" />
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
					<RadioButton x:Name="PreviewLight" Content="Preview light" Margin="0,0,16,0" GroupName="Mode" Checked="Mode_Checked" />
					<RadioButton x:Name="PreviewDark" Content="Preview dark" GroupName="Mode" Checked="Mode_Checked" />
				</StackPanel>
			</Grid>
			<WrapPanel x:Name="Gallery" />
			<TextBlock x:Name="ErrorText" Style="{StaticResource CaptionText}" Foreground="{DynamicResource CriticalBrush}" Visibility="Collapsed" Margin="0,8,0,0" />
		</StackPanel>
	</ScrollViewer>
</UserControl>
