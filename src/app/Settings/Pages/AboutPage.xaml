<UserControl x:Class="ContextShell.Settings.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<StackPanel Margin="36,28,36,36" MaxWidth="1000">
			<TextBlock Style="{StaticResource TitleText}" Text="About" />

			<Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="20">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Image Source="/Assets/logo.png" Width="56" Height="56" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Top" />
					<StackPanel Grid.Column="1" Margin="20,0,0,0">
						<TextBlock Style="{StaticResource SubtitleText}" Text="ContextShell" />
						<TextBlock x:Name="VersionText" Style="{StaticResource SecondaryText}" />
						<TextBlock x:Name="Description" Margin="0,8,0,0" />
						<WrapPanel Margin="0,12,0,0">
							<Button Style="{StaticResource LinkButton}" Content="GitHub" Click="GitHub_Click" Margin="0,0,20,0" />
							<Button Style="{StaticResource LinkButton}" Content="Report a problem" Click="Issues_Click" Margin="0,0,20,0" />
							<Button Style="{StaticResource LinkButton}" Content="Release notes" Click="Releases_Click" Margin="0,0,20,0" />
							<Button Style="{StaticResource LinkButton}" Content="Config docs" Click="Docs_Click" Margin="0,0,20,0" />
							<Button Style="{StaticResource LinkButton}" Content="MIT License" Click="License_Click" />
						</WrapPanel>
					</StackPanel>
				</Grid>
			</Border>

			<TextBlock Margin="0,24,0,10" Style="{StaticResource BodyStrongText}" Text="Advanced" />
			<Border Style="{StaticResource SettingRow}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="40" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" />
					<StackPanel Grid.Column="1" VerticalAlignment="Center">
						<TextBlock Text="Config folder" />
						<TextBlock x:Name="FolderText" Style="{StaticResource CaptionText}" />
					</StackPanel>
					<Button Grid.Column="2" Content="Open folder" Click="Folder_Click" />
				</Grid>
			</Border>
			<Border Style="{StaticResource SettingRow}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="40" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock Style="{StaticResource IconText}" Text="&#xE943;" />
					<StackPanel Grid.Column="1" VerticalAlignment="Center">
						<TextBlock Text="Edit shell.nss" />
						<TextBlock Style="{StaticResource CaptionText}" Text="For custom items and anything Settings doesn't cover. Opens Notepad as administrator." />
					</StackPanel>
					<Button Grid.Column="2" Content="Edit" Click="Edit_Click" />
				</Grid>
			</Border>
			<Border Style="{StaticResource SettingRow}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="40" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<TextBlock Style="{StaticResource IconText}" Text="&#xE90F;" />
					<StackPanel Grid.Column="1" VerticalAlignment="Center">
						<TextBlock Text="Classic manager" />
						<TextBlock Style="{StaticResource CaptionText}" Text="The original shell.exe window for registering and unregistering." />
					</StackPanel>
					<Button Grid.Column="2" Content="Open" Click="Classic_Click" />
				</Grid>
			</Border>

			<TextBlock Margin="0,24,0,0" Style="{StaticResource CaptionText}"
			           Text="Based on Nilesoft Shell by Nilesoft Ltd. Uses plutovg, plutosvg and Microsoft Detours. MIT License." />
		</StackPanel>
	</ScrollViewer>
</UserControl>
