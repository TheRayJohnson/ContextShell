<UserControl x:Class="ContextShell.Settings.Pages.UpdatesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
	<ScrollViewer VerticalScrollBarVisibility="Auto">
		<StackPanel Margin="36,28,36,36" MaxWidth="1000">
			<TextBlock Style="{StaticResource TitleText}" Text="Updates" />

			<Border Style="{StaticResource Card}" Margin="0,24,0,0" Padding="20">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
						<ColumnDefinition Width="Auto" />
					</Grid.ColumnDefinitions>
					<Border x:Name="StatusBadge" Width="48" Height="48" CornerRadius="24" Background="{DynamicResource AccentSubtleBrush}" VerticalAlignment="Top">
						<TextBlock x:Name="StatusGlyph" Text="&#xE895;" FontFamily="{StaticResource IconFont}" FontSize="22"
						           Foreground="{DynamicResource AccentForegroundBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
					</Border>
					<StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
						<TextBlock x:Name="StatusTitle" Style="{StaticResource SubtitleText}" Text="Check for updates" />
						<TextBlock x:Name="StatusText" Margin="0,4,0,0" Style="{StaticResource SecondaryText}" />
						<ProgressBar x:Name="DownloadBar" Margin="0,12,0,0" Minimum="0" Maximum="1" Visibility="Collapsed" />
					</StackPanel>
					<StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
						<Button x:Name="SkipButton" Content="Skip this version" Margin="0,0,8,0" Visibility="Collapsed" Click="Skip_Click" />
						<Button x:Name="ActionButton" Style="{StaticResource AccentButton}" Content="Check for updates" Click="Action_Click" />
					</StackPanel>
				</Grid>
			</Border>

			<Border x:Name="NotesCard" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="20" Visibility="Collapsed">
				<StackPanel>
					<Grid>
						<TextBlock x:Name="NotesTitle" Style="{StaticResource BodyStrongText}" />
						<Button x:Name="NotesLink" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Content="Full release notes" Click="Notes_Click" />
					</Grid>
					<TextBlock x:Name="NotesText" Margin="0,10,0,0" Style="{StaticResource SecondaryText}" />
				</StackPanel>
			</Border>

			<TextBlock Margin="0,24,0,10" Style="{StaticResource BodyStrongText}" Text="Preferences" />
			<Border Style="{StaticResource SettingRow}">
				<Grid>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="40" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<TextBlock Style="{StaticResource IconText}" Text="&#xE823;" />
					<CheckBox x:Name="AutoBox" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Checked="Auto_Changed" Unchecked="Auto_Changed">
						<StackPanel>
							<TextBlock Text="Check for updates when I sign in" />
							<TextBlock Style="{StaticResource CaptionText}"
							           Text="At most once a day. ContextShell only asks GitHub for the latest release; nothing about you or your PC is sent." />
						</StackPanel>
					</CheckBox>
				</Grid>
			</Border>
			<TextBlock x:Name="LastChecked" Margin="4,8,0,0" Style="{StaticResource CaptionText}" />
		</StackPanel>
	</ScrollViewer>
</UserControl>
