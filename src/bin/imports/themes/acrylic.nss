// Frosted acrylic blur behind a mostly opaque background, so text stays readable.
// Raise opacity (0-100) for a more solid menu, lower it for more glass.
// Needs "Transparency effects" on in Windows Settings > Personalisation > Colours.
theme
{
	name="modern"
	dark=auto
	background
	{
		color=auto
		opacity=85
		effect=3
	}
	image.align=2
}
